{
  "name": "scroll-video-webflow",
  "version": "1.1.0",
  "private": true,
  "description": "Fond video pilote au scroll pour Webflow : scrub sur la section 1, boucle sur la section 2, bascule a chaud entre deux use-cases.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp src/styles/scroll-video.css dist/",
    "preview": "vite preview",
    "test": "node --test 'test/*.test.mjs'",
    "test:e2e": "node test/e2e.mjs",
    "encode": "./scripts/encode.sh",
    "upload": "./scripts/upload-bunny.sh",
    "serve": "python3 -m http.server 5181",
    "test:bundle": "DEMO_URL=http://localhost:5181/demo/bundle.html node test/e2e.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^7.1.3"
  }
}
