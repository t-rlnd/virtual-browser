{
  "name": "scroll-video-webflow",
  "version": "1.1.0",
  "private": true,
  "description": "Fond video pilote au scroll pour Webflow : scrub sur la section 1, boucle sur la section 2, bascule a chaud entre deux use-cases.",
  "type": "module",
  "scripts": {
    "dev": "node ./bin/build.js",
    "build": "NODE_ENV=production node ./bin/build.js",
    "test": "node --test 'test/*.test.mjs'",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.playwright node test/e2e.mjs",
    "test:bundle": "DEMO_URL=http://localhost:3000/demo/bundle.html PLAYWRIGHT_BROWSERS_PATH=$PWD/.playwright node test/e2e.mjs",
    "encode": "./scripts/encode.sh",
    "upload": "./scripts/upload-bunny.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  },
  "engines": {
    "pnpm": ">=10"
  }
}
